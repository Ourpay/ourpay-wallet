{
  "name": "@ourpay/agent-wallets",
  "version": "0.9.1",
  "private": true,
  "description": "OurPay wallets for AI agents and their owners",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ourpay-wallet": "./dist/cli.js",
    "ourpay-wallet-configure": "./dist/configure.js"
  },
  "exports": {
    ".": "./dist/client.js",
    "./mcp": "./dist/mcp.js",
    "./remote": "./dist/remote.js",
    "./adapters": "./dist/adapters.js",
    "./provider": "./dist/provider.js",
    "./walletconnect": "./dist/walletconnect.js",
    "./integrations": "./dist/integrations.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@reown/walletkit": "1.6.0",
    "@types/node": "24.12.0",
    "@walletconnect/types": "2.25.0",
    "@walletconnect/utils": "2.25.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "smol-toml": "1.9.0",
    "solc": "0.8.37",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  },
  "peerDependencies": {
    "@reown/walletkit": "^1.6.0",
    "@walletconnect/types": "^2.25.0",
    "@walletconnect/utils": "^2.25.0"
  },
  "peerDependenciesMeta": {
    "@reown/walletkit": {
      "optional": true
    },
    "@walletconnect/types": {
      "optional": true
    },
    "@walletconnect/utils": {
      "optional": true
    }
  }
}
